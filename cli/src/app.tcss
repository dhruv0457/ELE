/* ELE Agent CLI - Professional AI Theme (Textual CSS only) */
$primary: #1e88e5;
$primary-dark: #1565c0;
$primary-light: #64b5f6;
$success: #2e7d32;
$warning: #f57f17;
$error: #c62828;
$surface: #ffffff;
$surface-elevated: #f8f9fa;
$text: #1a1a2e;
$text-secondary: #4a4a6a;
$text-muted: #8a8aa0;
$border: #e0e4ec;
$border-focus: #1e88e5;
$chat-user: #1e88e5;
$chat-assistant: #f0f4f8;
$code-bg: #f0f4f8;

/* Base - Light Professional Theme */
Screen {
    background: $surface;
    color: $text;
}

Header {
    background: $surface;
    color: $text;
    border-bottom: solid $border;
    height: 1;
}

Header:focus {
    border-bottom: solid $primary;
}

Footer {
    background: $surface;
    color: $text-muted;
    border-top: solid $border;
    height: 1;
}

/* Buttons */
Button {
    background: $surface;
    color: $primary;
    border: solid $primary;
    min-width: 10;
    height: 3;
}

Button:hover {
    background: $primary-light;
    color: $surface;
}

Button:focus {
    border: solid $primary-dark;
}

Button.-primary {
    background: $primary;
    color: $surface;
}

Button.-primary:hover {
    background: $primary-dark;
}

Button.-secondary {
    background: $surface-elevated;
    color: $text-secondary;
    border: solid $border;
}

Button.-secondary:hover {
    background: $border;
    color: $text;
}

Button.-ghost {
    background: transparent;
    color: $text-secondary;
    border: none;
}

Button.-ghost:hover {
    background: $border;
    color: $text;
}

/* Input - SMALLER */
Input, TextArea {
    background: $surface;
    color: $text;
    border: solid $border;
    height: 3;
}

Input:focus, TextArea:focus {
    border: solid $border-focus;
}

/* Select */
Select {
    background: $surface;
    color: $text;
    border: solid $border;
}

Select:focus {
    border: solid $border-focus;
}

/* ListView */
ListView {
    background: $surface;
    border: solid $border;
}

ListView > .list-view--item {
    background: $surface;
    color: $text;
}

ListView > .list-view--item.--highlight {
    background: $primary-light;
    color: $surface;
}

/* Tree */
Tree {
    background: $surface;
    border: solid $border;
}

Tree > .tree--node {
    color: $text;
}

Tree > .tree--node.--highlight {
    background: $primary-light;
    color: $surface;
}

/* Collapsible */
Collapsible {
    background: $surface;
    border: solid $border;
}

Collapsible > .collapsible--title {
    text-style: bold;
    color: $primary;
}

/* Static */
Static {
    color: $text;
}

/* Label */
Label {
    color: $text;
}

/* Container */
Container {
    background: $surface;
}

/* Horizontal / Vertical */
Horizontal, Vertical {
    background: $surface;
}

/* TabbedContent */
TabbedContent {
    background: $surface;
}

TabbedContent > .tabbed-content--tab-bar {
    background: $surface;
    border-bottom: solid $border;
}

TabbedContent > .tabbed-content--tab-bar > .tabbed-content--tab {
    color: $text-secondary;
}

TabbedContent > .tabbed-content--tab-bar > .tabbed-content--tab.--active {
    color: $primary;
    text-style: bold;
    border-bottom: solid $primary;
}

/* Switch */
Switch {
    background: $surface;
    border: solid $border;
}

Switch.--on {
    background: $primary;
}

/* Scrollbar */
.scrollbar {
    background: $surface;
}

.scrollbar--slider {
    background: $primary-light;
}

/* Tooltip */
.tooltip {
    background: $surface-elevated;
    border: solid $border;
    color: $text;
}

/* Notification */
.notification {
    background: $surface-elevated;
    border: solid $border;
    color: $text;
}

.notification.--information {
    border-left: solid $primary;
}

.notification.--warning {
    border-left: solid $warning;
}

.notification.--error {
    border-left: solid $error;
}

/* DataTable */
DataTable {
    background: $surface;
    border: solid $border;
}

DataTable > .datatable--header {
    background: $surface-elevated;
    color: $text;
}

DataTable > .datatable--row {
    background: $surface;
    color: $text;
}

DataTable > .datatable--row.--highlight {
    background: $primary-light;
    color: $surface;
}

/* Markdown */
.markdown {
    color: $text;
}

.markdown-pre {
    background: $code-bg;
    border: solid $border;
    padding: 1;
}

/* Chat-specific */
#messages_container {
    background: $surface;
    border: solid $border;
    margin: 0;
}

#messages_list {
    background: $surface;
}

#input_bar {
    background: $surface-elevated;
    border-top: solid $border;
    padding: 0 2;
    height: auto;
    min-height: 4;
}

#input_area {
    background: $surface;
    border: solid $border;
    height: 3;
    max-height: 6;
}

#input_area:focus {
    border: solid $primary;
}

#send_btn {
    background: $primary;
    color: $surface;
    border: none;
    width: 10;
    height: 3;
}

#send_btn:hover {
    background: $primary-dark;
}

#voice_btn {
    background: transparent;
    color: $text-secondary;
    border: none;
    width: 5;
    height: 3;
}

#voice_btn:hover {
    background: $border;
    color: $primary;
}

#voice_btn.-active {
    color: $error;
}

#status_line {
    color: $text-muted;
    text-style: dim;
    height: 1;
    padding: 0 2;
    background: $surface;
    border-bottom: solid $border;
}

.sidebar {
    background: $surface-elevated;
    border-right: solid $border;
    width: 32;
}

.sidebar-title {
    text-style: bold;
    color: $primary;
    margin: 1 0;
    padding: 0 1;
}

/* Message bubbles */
.user-bubble {
    background: $primary;
    color: $surface;
    margin: 1 2;
    margin-left: 6;
    padding: 1 2;
    max-width: 85%;
}

.assistant-bubble {
    background: #f0f4f8;
    color: $text;
    margin: 1 2;
    margin-right: 6;
    padding: 1 2;
    border: solid $border;
    max-width: 85%;
}

.message-meta {
    color: $text-muted;
    text-style: dim;
    margin-bottom: 1;
    height: 1;
}

.bubble-content {
}

.thought-preview {
    color: $text-muted;
    text-style: italic;
    margin: 1 0;
    padding-left: 1;
    border-left: solid $primary-light;
    background: #f8f9fa;
}

.tool-preview {
    color: $warning;
    margin: 1 0;
    padding: 0 1;
    background: #f8f9fa;
    border-left: solid $warning;
}

.streaming-cursor {
    color: $primary;
    text-style: bold blink;
}

.tools-used {
    margin-top: 1;
    height: auto;
}

.tool-badge {
    background: #64b5f6;
    color: #ffffff;
    padding: 0 1;
    margin-right: 1;
}

.message-time {
    color: #8a8aa0;
    text-style: dim;
}

.message-role {
    text-style: bold;
    color: #1e88e5;
}

/* Status badge */
.status-connected {
    color: $success;
}

.status-disconnected {
    color: $error;
}

/* Thinking panel - expanded */
.thinking-panel {
    background: #f8f9fa;
    border-left: solid $primary-light;
    padding: 1;
    margin: 1 0;
}

.thinking-line {
    color: $text-muted;
    text-style: italic;
    margin: 0;
}

.tool-line {
    color: $warning;
    margin: 0;
}