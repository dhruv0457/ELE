/* D:/ELE/cli/src/app.tcss */
/* Deep void black background: #0A0E17 */
/* Neon cyan: #00FFE0 */
/* Soft purple: #A855F7 */
/* Matrix green: #00FF9D */
/* Very dark code bg: #060810 */
/* Cyan-tinted code text: #38BDF8 */

Screen {
    background: #0A0E17;
    color: #E2E8F0;
}

Header {
    background: #0A0E17;
    color: #00FFE0;
    height: 1;
    dock: top;
    border-bottom: hkey #1E293B;
}

HeaderIcon {
    display: none;
}

Footer {
    background: #0A0E17;
    color: #64748B;
    height: 1;
    dock: bottom;
}

Footer > .footer--highlight {
    background: #0A0E17;
    color: #00FFE0;
}

Footer > .footer--highlight-key {
    background: #0A0E17;
    color: #A855F7;
    text-style: bold;
}

Footer > .footer--key {
    color: #A855F7;
    text-style: bold;
}

/* Button styles */
Button {
    background: transparent;
    color: #E2E8F0;
    border: none;
    height: auto;
    min-width: 4;
}

Button:hover {
    background: #1E293B;
    color: #00FFE0;
}

Button.-primary {
    background: #00FFE0;
    color: #0A0E17;
    text-style: bold;
}

Button.-primary:hover {
    background: #00FF9D;
}

/* Inputs */
Input, TextArea {
    background: #121A2F;
    border: none;
    color: #E2E8F0;
}

Input:focus, TextArea:focus {
    border: wide #00FFE0;
}

/* ListView */
ListView {
    background: #0A0E17;
}

ListItem {
    background: transparent;
    color: #E2E8F0;
    padding: 0 1;
}

ListItem:hover, ListItem.-highlight {
    background: #121A2F;
    color: #00FFE0;
    border-left: wide #00FFE0;
}

/* Select */
Select {
    background: #121A2F;
    color: #E2E8F0;
    border: none;
}

Select:focus {
    border: wide #00FFE0;
}

/* Collapsible */
Collapsible {
    background: #0A0E17;
}

CollapsibleTitle {
    color: #A855F7;
    text-style: bold;
}

/* TabbedContent */
TabbedContent {
    background: #0A0E17;
}

TabPane {
    background: #0A0E17;
}

Tabs {
    background: #0A0E17;
    border-bottom: solid #1E293B;
}

Tab {
    color: #64748B;
}

Tab.-active {
    color: #00FFE0;
    border-bottom: wide #00FFE0;
}

/* Scrollbar */
Scrollbar {
    background: #0A0E17;
}

Scrollbar > .scrollbar--slider {
    background: #1E293B;
}

Scrollbar > .scrollbar--slider:hover {
    background: #00FFE0;
}

/* Markdown */
Markdown {
    background: #0A0E17;
    color: #E2E8F0;
}

MarkdownFence {
    background: #060810;
    border: none;
    padding: 1;
    color: #38BDF8;
}

MarkdownBlockQuote {
    border-left: wide #A855F7;
    padding-left: 1;
    background: #121A2F;
}

/* DataTable */
DataTable {
    background: #0A0E17;
}
DataTable > .datatable--header {
    background: #121A2F;
    color: #00FFE0;
}

/* Containers */
#main_container, #chat_main, #chat_screen {
    background: #0A0E17;
    width: 100%;
    height: 100%;
}

#status_line {
    height: 1;
    color: #64748B;
    border-bottom: solid #1E293B;
    background: #0A0E17;
}

#messages_container, #messages_list {
    background: #0A0E17;
    border: none;
}

/* Input Bar */
#input_bar {
    background: #121A2F;
    border-top: solid #1E293B;
    min-height: 3;
    height: auto;
    layout: horizontal;
    padding: 1;
}

#input_area {
    background: #060810;
    border: none;
    height: 3;
    max-height: 6;
    width: 1fr;
}

#input_area:focus {
    border: wide #00FFE0;
}

#send_btn {
    background: #00FFE0;
    color: #0A0E17;
    text-style: bold;
    border: none;
    margin-left: 1;
    height: 3;
}

#voice_btn {
    background: transparent;
    color: #64748B;
    border: none;
    margin-left: 1;
    height: 3;
}

#voice_btn:hover {
    color: #00FFE0;
}

/* Sidebar */
.sidebar {
    background: #121A2F;
    border-right: solid #1E293B;
    width: 22;
    padding: 1;
    height: 100%;
}

.sidebar-title {
    color: #00FFE0;
    text-style: bold;
    margin-bottom: 1;
}

.sidebar-item {
    background: transparent;
    content-align: left middle;
    height: 1;
    width: 1fr;
    color: #E2E8F0;
    border: none;
    margin-bottom: 0;
}

.sidebar-item:hover, .sidebar-item.-active {
    color: #00FFE0;
    background: #1E293B;
    border-left: wide #00FFE0;
}

/* Chat Bubbles */
.user-bubble {
    background: #121A2F;
    border-left: wide #00FFE0;
    padding: 1;
    margin: 1 0;
}

.assistant-bubble {
    background: #1E293B;
    border-left: wide #A855F7;
    padding: 1;
    margin: 1 0;
}

.message-meta {
    layout: horizontal;
    height: 1;
    margin-bottom: 1;
}

.message-role {
    color: #00FFE0;
    text-style: bold;
}

.message-time {
    color: #64748B;
    margin-left: 1;
}

/* Thinking Panel */
.thinking-panel {
    background: #121A2F;
    border-left: wide #A855F7;
    padding: 1;
    margin: 1 0;
}

.thought-preview {
    color: #A855F7;
    text-style: italic;
}

/* Tools */
.tool-preview, .tool-badge {
    color: #F59E0B;
    background: #451A03;
    padding: 0 1;
}

.streaming-cursor {
    color: #00FFE0;
    text-style: bold;
}

/* Notifications */
Notification {
    background: #121A2F;
    color: #E2E8F0;
    border: wide #00FFE0;
}

Toast {
    background: #1E293B;
    color: #00FF9D;
}

/* Settings & Plugins */
.setting-group {
    background: #0A0E17;
    margin: 1 0;
}

.setting-label {
    color: #E2E8F0;
    text-style: bold;
}

.setting-item {
    background: #121A2F;
    padding: 1;
    margin-bottom: 1;
}

.plugin-item {
    background: #121A2F;
    padding: 1;
    margin: 1 0;
    border-left: wide #00FFE0;
}

.plugin-name {
    color: #00FFE0;
    text-style: bold;
}

.plugin-desc {
    color: #64748B;
}

/* Switches & Trees */
Switch {
    background: #1E293B;
}

Switch > .switch--slider {
    background: #64748B;
}

Switch:focus {
    border: none;
}

Switch.-on {
    background: #00FF9D;
}

Switch.-on > .switch--slider {
    background: #E2E8F0;
}

Tree {
    background: #0A0E17;
    color: #E2E8F0;
}

Tree:focus {
    border: none;
}

Tree > .tree--cursor {
    background: #1E293B;
}