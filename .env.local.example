# ELE Agent Local Development Configuration
# Copy to .env and modify as needed

# App
APP_NAME=ELE Agent
VERSION=1.0.0
DEBUG=true

# Supabase - Use local Supabase or create a free project at supabase.com
# For local dev without Supabase, you can use the mock auth in development
SUPABASE_URL=http://localhost:54321
SUPABASE_ANON_KEY=your-local-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-local-service-role-key

# Auth
JWT_SECRET=local-development-secret-change-in-production
JWT_ALGORITHM=HS256
JWT_EXPIRY_HOURS=24

# Platform API Keys (optional - for managed credits)
# Leave empty to use BYOK (Bring Your Own Key) mode
OPENAI_API_KEY=
GEMINI_API_KEY=
OPENCLAW_API_KEY=
ANTHROPIC_API_KEY=

# Telegram Bot (optional)
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=

# Voice (optional)
# Porcupine access key from https://console.picovoice.ai/
PORCUPINE_ACCESS_KEY=
# Vosk model path - download from https://alphacephei.com/vosk/models
VOSK_MODEL_PATH=~/.ele-agent/vosk-model

# Monitoring (optional)
SENTRY_DSN=

# Storage
DATA_DIR=~/.ele-agent

# Rate Limiting
RATE_LIMIT_FREE_RPM=30
RATE_LIMIT_PRO_RPM=120
RATE_LIMIT_TEAM_RPM=300

# Credits
FREE_CREDITS_DAILY=100
PRO_CREDITS_DAILY=1000
TEAM_CREDITS_DAILY=5000

# Web Frontend
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_SUPABASE_URL=http://localhost:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-local-anon-key