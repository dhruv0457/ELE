# ==============================================================================
# ELE Agent - Production Environment Configuration Reference
# Rename to .env in production deployment
# ==============================================================================

# ------------------------------------------------------------------------------
# Server & Environment
# ------------------------------------------------------------------------------
APP_ENV=production
DEBUG=false
HOST=0.0.0.0
PORT=8000
BACKEND_PORT=8000
WEB_PORT=3000

# ------------------------------------------------------------------------------
# Security & Authentication
# ------------------------------------------------------------------------------
# Generate a strong 64-character secret key for production JWT tokens:
# e.g., run: openssl rand -hex 32
JWT_SECRET_KEY=generate_strong_64_char_secret_key_here
JWT_ALGORITHM=HS256
JWT_EXPIRATION_MINUTES=1440
CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000","https://yourdomain.com"]

# ------------------------------------------------------------------------------
# Database Settings
# ------------------------------------------------------------------------------
# SQLite default (Local/Container volume):
DATABASE_URL=sqlite+aiosqlite:///app/data/ele_agent.db
# PostgreSQL (Enterprise/Production Cloud):
# DATABASE_URL=postgresql+asyncpg://ele_user:ele_password@postgres:5432/ele_db

# ------------------------------------------------------------------------------
# AI & LLM Provider API Keys (Configure at least one)
# ------------------------------------------------------------------------------
# NVIDIA NIM (Access to 102+ Models: Llama 3.3 70B, Nemotron, DeepSeek R1, Mistral Large)
# Free API Key at: https://build.nvidia.com
NVIDIA_API_KEY=

# Google Gemini (Gemini 2.0 Flash, Gemini 1.5 Pro)
# Free API Key at: https://aistudio.google.com
GEMINI_API_KEY=

# Groq Cloud (Ultra-Fast 500-800 tokens/sec LPU Inference)
# Free API Key at: https://console.groq.com
GROQ_API_KEY=

# OpenAI (GPT-4o, GPT-4o-mini)
OPENAI_API_KEY=

# Anthropic Claude (Claude 3.5 Sonnet)
ANTHROPIC_API_KEY=

# Local Ollama (Self-Hosted Air-Gapped)
OLLAMA_BASE_URL=http://localhost:11434/v1

# ------------------------------------------------------------------------------
# Storage, Workspace & Logging Paths
# ------------------------------------------------------------------------------
STORAGE_DIR=./storage
LOGS_DIR=./logs
LOG_LEVEL=INFO

# ------------------------------------------------------------------------------
# Speech & Jarvis Voice Engine
# ------------------------------------------------------------------------------
VOICE_ENABLED=true
DEFAULT_TTS_VOICE=en-GB-RyanNeural
SPEECH_RECOGNITION_TIMEOUT=5

# ------------------------------------------------------------------------------
# Web Frontend Configuration
# ------------------------------------------------------------------------------
NEXT_PUBLIC_API_URL=/api/v1