# ELE Agent Backend Configuration

# App
APP_NAME=ELE Agent
VERSION=1.0.0
DEBUG=true

# Supabase (Required)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Auth
JWT_SECRET=your-super-secret-jwt-key-change-in-production
JWT_ALGORITHM=HS256
JWT_EXPIRY_HOURS=24

# Platform API Keys (for managed credits)
OPENAI_API_KEY=
GEMINI_API_KEY=
OPENCLAW_API_KEY=
ANTHROPIC_API_KEY=

# Telegram
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=

# Voice
PORCUPINE_ACCESS_KEY=
VOSK_MODEL_PATH=~/.ele-agent/vosk-model

# Monitoring
SENTRY_DSN=

# Storage
DATA_DIR=~/.ele-agent

# Rate Limiting
RATE_LIMIT_FREE_RPM=30
RATE_LIMIT_PRO_RPM=120
RATE_LIMIT_TEAM_RPM=300

# Credits
FREE_CREDITS_DAILY=100
PRO_CREDITS_DAILY=1000
TEAM_CREDITS_DAILY=5000