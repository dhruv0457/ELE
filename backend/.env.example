# ELE Agent Backend Configuration
# Copy this file to .env and fill in your API keys

# App
DEBUG=True
APP_NAME=ELE Agent
VERSION=1.0.0

# Database
DATABASE_URL=sqlite+aiosqlite:///./ele_agent.db

# Supabase (Optional - for cloud sync)
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Auth
JWT_SECRET=dev-secret-change-in-production
JWT_ALGORITHM=HS256
JWT_EXPIRY_HOURS=24

# API Keys (at least one required for real LLM responses)
# Get free NVIDIA key at https://build.nvidia.com
NVIDIA_API_KEY=

# Get free Groq key at https://console.groq.com/keys
GROQ_API_KEY=

# Get OpenAI key at https://platform.openai.com/api-keys
OPENAI_API_KEY=

# Get Gemini key at https://makersuite.google.com/app/apikey
GEMINI_API_KEY=

# Get Anthropic key at https://console.anthropic.com/
ANTHROPIC_API_KEY=

# NVIDIA NIM
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1

# Telegram (Optional)
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=

# Voice (Optional)
PORCUPINE_ACCESS_KEY=
VOSK_MODEL_PATH=~/.ele-agent/voice/vosk-model

# Monitoring (Optional)
SENTRY_DSN=

# Data
DATA_DIR=~/.ele-agent

# Rate Limiting
RATE_LIMIT_FREE_RPM=30
RATE_LIMIT_PRO_RPM=120
RATE_LIMIT_TEAM_RPM=300

# Credits
FREE_CREDITS_DAILY=100
PRO_CREDITS_DAILY=1000
TEAM_CREDITS_DAILY=5000